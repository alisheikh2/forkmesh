+qint64 MainWindow::cachedMirrorRepoSizeBytes(const RepositoryRecord &repo,
+                                             bool refreshIfStale)
+{
+    const QString mirrorPath = repo.mirrorPath.trimmed();
+    if (mirrorPath.isEmpty() || !QDir(mirrorPath).exists()) {
+        m_mirrorRepoSizeCache.remove(mirrorPath);
+        m_mirrorRepoSizeRefreshes.remove(mirrorPath);
+        return 0;
+    }
+
+    const qint64 syncMs = repo.lastSyncMs;
+    const auto cached = m_mirrorRepoSizeCache.constFind(mirrorPath);
+    if (cached != m_mirrorRepoSizeCache.cend() && cached->valid &&
+        cached->syncMs == syncMs)
+        return cached->bytes;
+
+    const qint64 fallback =
+        (cached != m_mirrorRepoSizeCache.cend() && cached->valid) ? cached->bytes : 0;
+    if (!refreshIfStale || m_mirrorRepoSizeRefreshes.contains(mirrorPath))
+        return fallback;
+
+    m_mirrorRepoSizeRefreshes.insert(mirrorPath);
+#ifdef FORKMESH_WINDOW_TESTS
+    ++m_testMirrorRepoSizeRefreshes;
+#endif
+    runGitDetached(mirrorPath, {"count-objects", "-v"},
+                   [this, mirrorPath, syncMs](bool ok, const QByteArray &out) {
+                       m_mirrorRepoSizeRefreshes.remove(mirrorPath);
+                       const qint64 bytes =
+                           ok ? parseCountObjectsSizeBytes(out) : 0;
+                       m_mirrorRepoSizeCache.insert(
+                           mirrorPath,
+                           MirrorRepoSizeCacheEntry{syncMs, bytes, true});
+                       m_mirrorAdvertSig.clear();
+                       refreshRepositoryList();
+                       if (m_repoDetailIndex >= 0 &&
+                           m_repoDetailIndex < m_repositories.size() &&
+                           m_repositories.at(m_repoDetailIndex).mirrorPath.trimmed() ==
+                               mirrorPath)
+                           loadMirrorNodesPanel();
+                   });
+    return fallback;
+}
