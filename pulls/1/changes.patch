+bool writeSlowGitWrapper(const QString &dir, const QString &realGit)
+{
+    QDir().mkpath(dir);
+    QFile file(QDir(dir).filePath(QStringLiteral("git")));
+    if (!file.open(QIODevice::WriteOnly | QIODevice::Truncate | QIODevice::Text))
+        return false;
+    QTextStream stream(&file);
+    stream << "#!/bin/sh\n"
+           << "if [ \"$1\" = \"-C\" ] && [ \"$3\" = \"rev-list\" ] && "
+              "[ \"$4\" = \"--max-parents=0\" ]; then\n"
+           << "  sleep 1\n"
+           << "fi\n"
+           << "exec \"" << realGit << "\" \"$@\"\n";
+    file.close();
+    return file.setPermissions(QFile::ReadOwner | QFile::WriteOwner |
+                               QFile::ExeOwner | QFile::ReadGroup |
+                               QFile::ExeGroup | QFile::ReadOther |
+                               QFile::ExeOther);
+}
