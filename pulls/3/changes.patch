+struct PublishRepositorySnapshot {
+    QString rootCommit;
+    QString stateHash;
+    QString publishedWebsite;
+    QString publishedDescription;
+    QString headBranch;
+    QString headCommit;
+    int issueCount = -1;
+    int commitCount = -1;
+    int branchCount = -1;
+    int pullCount = -1;
+    int discussionCount = -1;
+    int worktreeCount = -1;
+    int artifactCount = -1;
+    qint64 sizeBytes = 0;
+};
+
+QString hashPublishedRefs(const QByteArray &out)
+{
+    QStringList lines;
+    const QStringList rows = QString::fromUtf8(out).split('\n', Qt::SkipEmptyParts);
+    for (const QString &raw : rows) {
+        const QString line = raw.trimmed();
+        if (line.isEmpty() || line.endsWith(QStringLiteral("^{}")))
+            continue;
+        lines.append(line);
+    }
+    lines.sort();
+    return QString::fromUtf8(
+        QCryptographicHash::hash(lines.join('\n').toUtf8(),
+                                 QCryptographicHash::Sha256)
+            .toHex());
+}
+
+QString publishRootCommit(const RepositoryRecord &repo)
+{
+    const QString gitDir =
+        (!repo.localPath.trimmed().isEmpty() && QDir(repo.localPath).exists(".git"))
+            ? repo.localPath
+            : repo.mirrorPath;
+    auto firstRoot = [&](const QStringList &args) -> QString {
+        QByteArray out;
+        if (gitDir.trimmed().isEmpty() || !runGitCapture(gitDir, args, &out, nullptr))
+            return QString();
+        const QStringList roots =
+            QString::fromUtf8(out).split('\n', Qt::SkipEmptyParts);
+        return roots.isEmpty() ? QString() : roots.last().trimmed();
+    };
+    QString rootCommit = firstRoot({"rev-list", "--max-parents=0", "HEAD"});
+    if (rootCommit.isEmpty()) {
+        const QString branch = mirrorHeadBranch(gitDir);
+        if (!branch.isEmpty())
+            rootCommit = firstRoot({"rev-list", "--max-parents=0", branch});
+    }
+    if (rootCommit.isEmpty())
+        rootCommit = firstRoot({"rev-list", "--max-parents=0", "--all"});
+    return rootCommit;
+}
+
+QString publishStateHash(const QString &mirrorPath)
+{
+    if (mirrorPath.trimmed().isEmpty())
+        return QString();
+    QByteArray out;
+    if (!runGitCapture(mirrorPath,
+                       {"for-each-ref", "--format=%(objectname) %(refname)",
+                        "refs/heads/", "refs/tags/"},
+                       &out, nullptr))
+        return QString();
+    return hashPublishedRefs(out);
+}
+
+PublishRepositorySnapshot collectPublishRepositorySnapshot(
+    const RepositoryRecord &repo)
+{
+    PublishRepositorySnapshot snapshot;
+    snapshot.rootCommit = publishRootCommit(repo);
+    snapshot.stateHash = publishStateHash(repo.mirrorPath);
+    snapshot.publishedDescription = repo.description;
+    if (!repo.localPath.trimmed().isEmpty()) {
+        QFile file(QDir(repo.localPath).filePath(kRepoInfoPath));
+        if (file.open(QIODevice::ReadOnly)) {
+            const QJsonObject info = QJsonDocument::fromJson(file.readAll()).object();
+            snapshot.publishedWebsite =
+                info.value(QStringLiteral("website")).toString();
+            const QString about =
+                info.value(QStringLiteral("about")).toString().trimmed();
+            if (!about.isEmpty())
+                snapshot.publishedDescription = about;
+        }
+    }
+
+    snapshot.headBranch = mirrorHeadBranch(repo.mirrorPath);
+    snapshot.headCommit = mirrorBranchCommit(repo.mirrorPath, snapshot.headBranch);
+    snapshot.issueCount = mirrorIssueCount(repo.mirrorPath, snapshot.headBranch);
+    snapshot.commitCount = mirrorCommitCount(repo.mirrorPath, snapshot.headBranch);
+    snapshot.branchCount = mirrorBranchCount(repo.mirrorPath);
+    snapshot.pullCount = mirrorPullCount(repo.mirrorPath, snapshot.headBranch);
+    snapshot.discussionCount =
+        mirrorDiscussionCount(repo.mirrorPath, snapshot.headBranch);
+    snapshot.worktreeCount = mirrorWorktreeCount(repo.localPath);
+    snapshot.artifactCount = mirrorArtifactCount(repo.mirrorPath);
+    snapshot.sizeBytes = mirrorRepoSizeBytes(repo.mirrorPath);
+    return snapshot;
+}
+
+} // namespace
