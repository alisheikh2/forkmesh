+    // Importing a patch must not synchronously wait on `git apply --check` on the
+    // GUI thread. A fake git that sleeps before delegating makes the old blocking
+    // path take >1s; the fixed path returns immediately and finishes later.
+    {
+        QTemporaryDir importRepo;
+        QTemporaryDir fakeBin;
+        QTemporaryDir patchDir;
+        if (initGitRepo(importRepo) && fakeBin.isValid() && patchDir.isValid()) {
+            QFile wrapper(fakeBin.path() + QStringLiteral("/git"));
+            if (wrapper.open(QIODevice::WriteOnly | QIODevice::Text)) {
+                QTextStream ts(&wrapper);
+                ts << "#!/bin/sh\n"
+                   << "if [ \"$3\" = apply ] && [ \"$4\" = --check ]; then sleep 1; fi\n"
+                   << "exec /usr/bin/git \"$@\"\n";
+                wrapper.close();
+                wrapper.setPermissions(wrapper.permissions() | QFile::ExeOwner |
+                                       QFile::ExeGroup | QFile::ExeOther);
+            }
+            QFile patch(patchDir.path() + QStringLiteral("/change.patch"));
+            if (patch.open(QIODevice::WriteOnly | QIODevice::Text)) {
+                QTextStream ts(&patch);
+                ts << "diff --git a/new.txt b/new.txt\n"
+                   << "new file mode 100644\n"
+                   << "index 0000000..1269488\n"
+                   << "--- /dev/null\n"
+                   << "+++ b/new.txt\n"
+                   << "@@ -0,0 +1 @@\n"
+                   << "+hello\n";
+                patch.close();
+            }
+
+            MainWindow importWindow;
+            importWindow.show();
+            QApplication::processEvents();
+            const int idx = importWindow.testAddLocalRepository(
+                "me", "importrepo", importRepo.path());
+            importWindow.testOpenRepository(idx);
+            QApplication::processEvents();
+
+            const QByteArray oldPath = qgetenv("PATH");
+            qputenv("PATH", (fakeBin.path() + QLatin1Char(':') +
+                              QString::fromUtf8(oldPath)).toUtf8());
+            QElapsedTimer timer;
+            timer.start();
+            importWindow.testImportPatchAsPullFromPath(patch.fileName());
+            const qint64 elapsed = timer.elapsed();
+            qputenv("PATH", oldPath);
+
+            check(elapsed < 500,
+                  QString("import patch returns before slow apply check "
+                          "(elapsed=%1ms)")
+                      .arg(elapsed));
+            stopChildProcesses(importWindow);
+        }
+    }
